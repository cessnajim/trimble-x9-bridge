#!/bin/sh
# USB-C gadget link to the laptop: a single CDC-NCM network function (macOS, Linux and Windows 11 have native drivers).
set -e
G=/sys/kernel/config/usb_gadget/x9link
case "$1" in
  stop) [ -d $G ] || exit 0; echo "" > $G/UDC 2>/dev/null || true
        rm -f $G/configs/c.1/ncm.usb0; rmdir $G/configs/c.1/strings/0x409 $G/configs/c.1 $G/functions/ncm.usb0 $G/strings/0x409 $G 2>/dev/null || true; exit 0 ;;
esac
modprobe libcomposite
[ -d $G ] && exit 0
mkdir -p $G && cd $G
echo 0x1d6b > idVendor; echo 0x0104 > idProduct; echo 0x0100 > bcdDevice; echo 0x0200 > bcdUSB
mkdir -p strings/0x409
echo "x9bridge-$(cat /etc/machine-id | cut -c1-8)" > strings/0x409/serialnumber
echo "x9 bridge" > strings/0x409/manufacturer; echo "x9 bridge USB link" > strings/0x409/product
mkdir -p configs/c.1/strings/0x409; echo "NCM" > configs/c.1/strings/0x409/configuration; echo 250 > configs/c.1/MaxPower
mkdir -p functions/ncm.usb0
echo 02:58:39:00:00:01 > functions/ncm.usb0/dev_addr; echo 02:58:39:00:00:02 > functions/ncm.usb0/host_addr
ln -s functions/ncm.usb0 configs/c.1/
ls /sys/class/udc | head -1 > UDC

# /etc/x9-bridge/env: overrides for x9-bridge.service (root-only, 0600).
# Listen on every interface, so the laptop (USB-C link, 10.55.0.1) and laptop
# workers can reach the bridge. The default, 127.0.0.1:8795, is the Pi alone.
BRIDGE_ADDR=0.0.0.0:8795
# Recipes the bridge offers (read on every request).
BRIDGE_RECIPES=/etc/x9-bridge/recipes
# Pin the scanner link instead of letting x9-bridge-run choose:
#X9_BASE=http://192.168.43.1:34567/api/v1
# Memory budget for prepared stations (MB):
#BRIDGE_PREPARED_MB=2048
